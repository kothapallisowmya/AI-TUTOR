# ─────────────────────────────────────────────────────────
# BTech AI Tutor — Environment Variables Template
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://localhost:27017/btech-ai-tutor
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/btech-ai-tutor
MONGO_URI=

# AI API Keys (optional — only needed for real AI responses)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend URL (used for CORS in production)
FRONTEND_URL=http://localhost:3001

# JWT Secret for Authentication
JWT_SECRET=btech_ai_tutor_super_secret_key_2026
